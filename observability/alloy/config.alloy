// Grafana Alloy — P5 log collection (replaces promtail, EOL 2026-03-02).
// Labels preserved exactly: container / compose_service / compose_project /
// job="dhg-ai-factory" / level. Redaction stages per P5 spec §3.2 (operator-
// approved); healthcheck drop extended with the JSON form (ruling 2026-08-23).
// Positions persist under /var/lib/alloy/data (alloy_data volume).

discovery.docker "dhg_ai_factory" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "dhg_ai_factory" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.+)"
		target_label  = "container"
	}

	rule {
		target_label = "job"
		replacement  = "dhg-ai-factory"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}
}

loki.source.docker "dhg_ai_factory" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.docker.dhg_ai_factory.targets
	forward_to       = [loki.process.dhg_ai_factory.receiver]
	relabel_rules    = discovery.relabel.dhg_ai_factory.rules
	refresh_interval = "5s"
}

loki.process "dhg_ai_factory" {
	forward_to = [loki.write.default.receiver]

	// ---- Redaction (P5 spec §3.2, 6 stages — masks NEW lines, deletes nothing) ----
	// ALLOY SEMANTICS (proven live 2026-08-25): stage.replace substitutes the
	// CAPTURE GROUP content with the literal `replace` string; no ${1} expansion;
	// a groupless pattern is a no-op. The secret is always the capture group.
	// 1. Authorization header/field values
	stage.replace {
		expression = "(?i)authorization\"?\\s*[:=]\\s*\"?((?:bearer\\s+)?[A-Za-z0-9._~+/-]+=*)"
		replace    = "[REDACTED]"
	}

	// 2. JWT shape anywhere
	stage.replace {
		expression = "(eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,})"
		replace    = "[REDACTED_JWT]"
	}

	// 3. Cookie / Set-Cookie whole value
	stage.replace {
		expression = "(?i)(?:set-)?cookie\"?\\s*[:=]\\s*\"?([^\"]+)"
		replace    = "[REDACTED]"
	}

	// 4. api_key / token / secret / password key-value tails
	stage.replace {
		expression = "(?i)(?:api[_-]?key|token|secret|password)\"?\\s*[:=]\\s*\"?([^\"\\s,}]+)"
		replace    = "[REDACTED]"
	}

	// 5. OAuth codes/tokens in URLs
	stage.replace {
		expression = "(?i)[?&](?:code|state|access_token|id_token)=([^&\\s\"]+)"
		replace    = "[REDACTED]"
	}

	// 6. Doppler token shapes
	stage.replace {
		expression = "(dp\\.(?:st|ct|pt)\\.[A-Za-z0-9_-]{10,})"
		replace    = "[REDACTED_DOPPLER]"
	}

	// ---- Level extraction (unchanged from promtail) ----
	stage.regex {
		expression = "(?i)(?:\"level\"\\s*[:=]\\s*\"(?P<json_level>[^\"]+)\"|(?:^|\\s)level[=:]\\s*(?P<kv_level>DEBUG|INFO|WARN(?:ING)?|ERROR|FATAL|CRITICAL)|(?:^|\\s)(?P<pg_level>LOG|ERROR|FATAL|PANIC|WARNING|NOTICE|DEBUG)\\s*:)"
	}

	stage.template {
		source   = "level"
		template = "{{ if .json_level }}{{ .json_level }}{{ else if .kv_level }}{{ .kv_level }}{{ else if .pg_level }}{{ .pg_level }}{{ else }}unknown{{ end }}"
	}

	stage.labels {
		values = {
			level = null,
		}
	}

	stage.label_drop {
		values = ["json_level", "kv_level", "pg_level", "filename"]
	}

	// ---- Healthcheck noise drop (combined-log form + JSON/pino form; approved) ----
	stage.match {
		selector = "{job=\"dhg-ai-factory\"}"

		stage.drop {
			drop_counter_reason = "healthcheck"
			expression          = "\"(?:GET|HEAD) /(?:health[z]?|ready|metrics|api/health|api/tags|-/healthy|ok)\\s"
		}

		stage.drop {
			drop_counter_reason = "healthcheck_json"
			expression          = "\"url\"\\s*:\\s*\"/(?:health[z]?|ready|metrics)\""
		}
	}
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
	external_labels = {}
}
