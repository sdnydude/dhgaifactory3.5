# @DOC Alertmanager configuration TEMPLATE.
# @DOC
# @DOC The live file (observability/alertmanager/alertmanager.yml) is RENDERED
# @DOC from this template by observability/scripts/render-alertmanager.sh and is
# @DOC gitignored, because it embeds the Telegram bot token - which is itself a
# @DOC credential and must never enter git. Edit THIS file, then
# @DOC re-render. Lines prefixed "# @DOC" are stripped from the rendered output.
# @DOC
# @DOC Render markers understood by render-alertmanager.sh:
# @DOC   __TELEGRAM_BOT_TOKEN__       replaced with Doppler TELEGRAM_BOT_TOKEN
# @DOC   __TELEGRAM_CHAT_ID__         replaced with Doppler TELEGRAM_CHAT_ID
# @DOC   <line> # @TG_ONLY            kept only when both secrets exist
# @DOC   # @NO_TG <line>              uncommented only when a secret is absent
# @DOC   @TG_BEGIN / @TG_END          block kept only when both secrets exist
# @DOC   (the two block markers are column-0 lines further down this file)
# @DOC
# @DOC Severity routing contract (see observability/prometheus/alerts.yml header):
# @DOC   critical, high -> registry webhook (auto-creates an incident) AND Telegram
# @DOC   warning        -> Telegram only

global:
  resolve_timeout: 5m

route:
  receiver: 'telegram' # @TG_ONLY
  # @NO_TG receiver: 'webhook'
  group_by: ['alertname', 'service']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # critical/high must reach BOTH sinks. The registry webhook handler
    # (registry/api.py, /webhooks/alertmanager) drops every severity that is
    # not critical|high, so sending warnings there would be pure noise —
    # hence a dedicated combined receiver rather than `continue: true`.
    - match_re:
        severity: critical|high
      receiver: 'webhook-and-telegram' # @TG_ONLY
      # @NO_TG receiver: 'webhook'
      continue: false

receivers:
  - name: 'webhook'
    webhook_configs:
      - url: 'http://dhg-registry-api:8000/webhooks/alertmanager'
        send_resolved: true

# @TG_BEGIN
  - name: 'telegram'
    telegram_configs:
      - bot_token: '__TELEGRAM_BOT_TOKEN__'
        chat_id: __TELEGRAM_CHAT_ID__
        parse_mode: 'HTML'
        send_resolved: true
        message: |-
          <b>[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}</b>
          {{ range .Alerts }}severity <code>{{ .Labels.severity }}</code>{{ if .Labels.service }} · service <code>{{ .Labels.service }}</code>{{ end }}{{ if .Labels.instance }} · {{ .Labels.instance }}{{ end }}
          {{ .Annotations.summary }}
          {{ if .Annotations.runbook_url }}<a href="{{ .Annotations.runbook_url }}">Runbook</a>{{ end }}
          {{ end }}

  - name: 'webhook-and-telegram'
    webhook_configs:
      - url: 'http://dhg-registry-api:8000/webhooks/alertmanager'
        send_resolved: true
    telegram_configs:
      - bot_token: '__TELEGRAM_BOT_TOKEN__'
        chat_id: __TELEGRAM_CHAT_ID__
        parse_mode: 'HTML'
        send_resolved: true
        message: |-
          <b>[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] {{ .CommonLabels.alertname }}</b>
          {{ range .Alerts }}severity <code>{{ .Labels.severity }}</code>{{ if .Labels.service }} · service <code>{{ .Labels.service }}</code>{{ end }}{{ if .Labels.instance }} · {{ .Labels.instance }}{{ end }}
          {{ .Annotations.summary }}
          {{ if .Annotations.runbook_url }}<a href="{{ .Annotations.runbook_url }}">Runbook</a>{{ end }}
          {{ end }}
# @TG_END

inhibit_rules:
  # A critical alert suppresses the lower-severity noise for the same service.
  - source_matchers:
      - severity = critical
    target_matchers:
      - severity =~ "high|warning"
    equal: ['service']

  # The registry API is the incident sink itself: while it is down, every
  # registry-scoped alert is a consequence, not new information.
  - source_matchers:
      - alertname = RegistryApiDown
    target_matchers:
      - service = registry-api

  # A dead scrape target makes every per-service *Down alert for that same
  # instance redundant. Two-sided matches are excluded by Alertmanager, so
  # PrometheusTargetDown does not inhibit itself.
  - source_matchers:
      - alertname = PrometheusTargetDown
    target_matchers:
      - alertname =~ ".*Down"
    equal: ['instance']
