      },
      "description": "Time since the last COMPLETED write-then-read trace round-trip. This is the only signal that catches a silent drop (MinIO down or bucket missing): the health probe stays UP while traces vanish. Amber past 10 min, red past the 15 min LangfuseCanaryStale threshold. The canary runs every 5 min from cron, so a healthy value stays under ~5 min.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
