      "title": "DLQ Depth",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(memreg_dlq_depth{job=\"memreg\", service=\"memreg\"}) or vector(0)",
          "legendFormat": "depth",
          "refId": "A"
        }
      ],
      "description": "Current dead-letter queue depth. Guarded with `or vector(0)`: when the exporter stops publishing memreg_dlq_depth this reads 0 too, so read it next to \"DLQ metric present\" — a 0 there means this tile is a fallback, not a measurement."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Whether the exporter is publishing memreg_dlq_depth at all. MISSING means the DLQ depth panels are showing their `or vector(0)` fallback and the real queue depth is unknown — not that the queue is empty.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
