    {
      "id": 22,
      "type": "table",
      "title": "20 newest open deferred items",
      "description": "The most recently filed still-open items. Title is truncated to 140 characters in SQL so the column stays readable; age_days is whole days since created_at.",
      "datasource": {
        "type": "postgres",
        "uid": "registry-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "registry-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT substr(title, 1, 140)                                        AS title,\n       priority,\n       category,\n       project_name                                                 AS project,\n       floor(extract(epoch FROM now() - created_at) / 86400)::int    AS age_days\n  FROM deferred_items\n WHERE status = 'open'\n ORDER BY created_at DESC\n LIMIT 20"
        }
      ],
