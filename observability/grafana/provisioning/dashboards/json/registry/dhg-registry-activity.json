    {
      "id": 2,
      "type": "stat",
      "title": "Captures in range",
      "description": "Rows written across all eight capture tables inside the dashboard time range (default: last 30 days). This is memreg throughput \u2014 a flat zero means the capture pipeline has stopped, not that nothing happened.",
      "datasource": {
        "type": "postgres",
        "uid": "registry-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "registry-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sum(n) AS captures FROM (\n  SELECT count(*) AS n FROM deferred_items WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM decision_logs  WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM insights       WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM corrections    WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM bug_fixes      WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM ship_sessions  WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM agent_sessions WHERE $__timeFilter(created_at)\n  UNION ALL SELECT count(*) AS n FROM test_coverage  WHERE $__timeFilter(created_at)\n) s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
