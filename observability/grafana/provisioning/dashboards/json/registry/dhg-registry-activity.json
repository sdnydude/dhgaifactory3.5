    {
      "id": 11,
      "type": "timeseries",
      "title": "Captures per day by type",
      "description": "One series per capture table, counted by created_at per day over the dashboard range (default 30 days). Series that flatline are capture rules that have stopped firing.",
      "datasource": {
        "type": "postgres",
        "uid": "registry-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "registry-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, 'deferred items' AS metric, count(*) AS value\n  FROM deferred_items WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'decisions' AS metric, count(*) AS value\n  FROM decision_logs WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'insights' AS metric, count(*) AS value\n  FROM insights WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'corrections' AS metric, count(*) AS value\n  FROM corrections WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'bug fixes' AS metric, count(*) AS value\n  FROM bug_fixes WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'ship sessions' AS metric, count(*) AS value\n  FROM ship_sessions WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'agent sessions' AS metric, count(*) AS value\n  FROM agent_sessions WHERE $__timeFilter(created_at) GROUP BY 1\nUNION ALL SELECT date_trunc('day', created_at) AS time, 'test coverage' AS metric, count(*) AS value\n  FROM test_coverage WHERE $__timeFilter(created_at) GROUP BY 1\nORDER BY 1, 2"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum",
            "max"
