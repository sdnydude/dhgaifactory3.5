      },
      "description": "p95 of registry_read_latency (milliseconds), aggregated with sum by (le). The read histogram's largest finite bucket is 1000 ms, so quantiles above ~p99.5 are not resolvable. Registry traffic is sparse — a 5m rate window is undefined (NaN) in ~75% of windows — so the quantile is computed over a 1h window and spanNulls bridges the rest.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
