      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(registry_write_latency_bucket{service=~\"$service\", instance=~\"$instance\"}[1h])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "Write P95",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
