      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{job=\"registry-api\", service=~\"$service\", instance=~\"$instance\", status=~\"5..\"}[10m])) or vector(0))\n/\nsum(rate(http_requests_total{job=\"registry-api\", service=~\"$service\", instance=~\"$instance\"}[10m]))",
