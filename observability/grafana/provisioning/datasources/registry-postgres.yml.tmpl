apiVersion: 1

# TEMPLATE — this is the tracked source of truth. The rendered sibling
# registry-postgres.yml is GITIGNORED because Grafana's Postgres datasource has
# no env-file indirection for provisioning: the role password must appear
# literally in secureJsonData. Render it, never edit it, never commit it:
#
#   observability/scripts/render-grafana-datasources.sh
#   docker compose up -d grafana        # datasources are read at startup only
#
# The credential is the read-only registry role grafana_ro (Doppler
# dhg-monitoring/dev, secret REGISTRY_GRAFANA_RO_PASSWORD). That role is
# NOSUPERUSER / NOCREATEDB / NOCREATEROLE with SELECT-only grants and two
# server-side guards set with ALTER ROLE: statement_timeout = '10s' and
# default_transaction_read_only = on. The timeout is what makes it safe to point
# a dashboard at the production registry DB — no panel can pin a connection
# against a large sequential scan (AUDIT-2026-09 advisor review, CRITICAL #1).
#
# sslmode is disable because Grafana and dhg-registry-db share the internal
# docker network dhgaifactory35_dhg-network; the DB publishes no TLS endpoint.
# maxOpenConns 3 caps Grafana's share of the DB's max_connections = 100.

datasources:
  - name: Registry DB
    type: postgres
    uid: registry-pg
    access: proxy
    url: dhg-registry-db:5432
    user: grafana_ro
    # Grafana 10.2 reads the database name from the top-level field; newer
    # provisioning docs put it in jsonData. Both are set so the datasource
    # survives the eventual upgrade.
    database: dhg_registry
    isDefault: false
    editable: false
    jsonData:
      database: dhg_registry
      sslmode: disable
      maxOpenConns: 3
      maxIdleConns: 1
      connMaxLifetime: 300
      postgresVersion: 1500
      timescaledb: false
    secureJsonData:
      password: "__REGISTRY_GRAFANA_RO_PASSWORD__"
