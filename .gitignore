/*.png

# CodeGraph semantic index (regeneratable via `codegraph sync`)
.codegraph/

# Superpowers writing-plans scratch (session-local, not a repo artifact)
/whats-next.md

# Pyright container site-packages snapshots (regeneratable via docker cp)
.pyright-stubs/

# planning-with-files skill ephemeral output (repo root only; condensed
# outcomes already live in docs/TODO.md, commits, and docs/resolved-issues.md)
/task_plan.md
/task_plan_*.md
/findings.md
/findings_*.md
/progress.md
/progress_*.md
/dhg-memreg

# DB dumps — never commit (contains full registry/KB data)
backups/

# macOS AppleDouble metadata junk
._*

# graphify tool output (regeneratable; graphify-out is 17M)
/graphify-out/
/graphify-wiki/

# dated backups of the secrets override (e.g. *.bak.20260713_105003)
*.bak.*
!frontend/src/app/logs/

# Grafana dashboard verification renders (regenerated by observability/scripts/verify-dashboard.sh)
/observability/verify/*
!/observability/verify/.gitkeep
!/observability/verify/allow-empty/

# Rendered Alertmanager config — embeds the Slack incoming-webhook URL.
# Tracked source of truth is observability/alertmanager/alertmanager.yml.tmpl;
# regenerate with observability/scripts/render-alertmanager.sh
/observability/alertmanager/alertmanager.yml

# Rendered postgres_exporter multi-target auth_modules — embeds DB passwords.
# Tracked shape reference is observability/postgres-exporter/postgres_exporter.yml.example;
# regenerate with observability/postgres-exporter/render-postgres-exporter.sh
/observability/postgres-exporter/postgres_exporter.yml

# Rendered medkb OTLP env — embeds the Langfuse Basic auth header.
# Regenerate with observability/scripts/render-medkb-otel-env.sh
/services/medkb/.env.otel

# Rendered Grafana Postgres datasource — embeds the grafana_ro role password.
# Tracked source of truth is
# observability/grafana/provisioning/datasources/registry-postgres.yml.tmpl;
# regenerate with observability/scripts/render-grafana-datasources.sh
/observability/grafana/provisioning/datasources/registry-postgres.yml
